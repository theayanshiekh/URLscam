# PhishGuard AI environment
APP_NAME=PhishGuard AI
APP_ENV=development
DEBUG=false

# CORS: comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite by default. Swap to PostgreSQL later:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/phishguard
DATABASE_URL=sqlite:///./data/phishguard.db

# Optional admin/research API key (required for retrain endpoints)
ADMIN_API_KEY=

# Rate limiting
RATE_LIMIT_PER_MINUTE=30
BATCH_MAX_URLS=200
BATCH_MAX_BYTES=1048576

# Timeouts (seconds)
DNS_TIMEOUT=2.0
TLS_TIMEOUT=3.0
INTEL_TIMEOUT=4.0

# Redirect analysis is DISABLED by default (SSRF risk).
ENABLE_REDIRECT_ANALYSIS=false

# Optional threat intelligence (app works without these)
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_KEY=
URLHAUS_ENABLED=false

# Model
MODEL_PATH=../ml/models/phishguard_model.joblib
METRICS_PATH=../ml/evaluation/metrics.json
FEATURE_IMPORTANCE_PATH=../ml/evaluation/feature_importance.json

# Risk thresholds
THRESHOLD_LOW=29
THRESHOLD_MEDIUM=59
THRESHOLD_HIGH=79
